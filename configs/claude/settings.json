{
  "model": "opus",
  "permissions": {
    "defaultMode": "auto",
    "deny": ["PowerShell", "ScheduleWakeup"]
  },
  "skillOverrides": {
    "docs": "off",
    "docx": "off",
    "google-workspace": "off",
    "import-memory": "off",
    "morning": "off",
    "pdf": "off",
    "pptx": "off",
    "xlsx": "off"
  },
  "env": {
    "PONYTAIL_MAP": "0",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "PLANNOTATOR_SHARE": "disabled",
    "PLANNOTATOR_AI": "disabled",
    "PLANNOTATOR_JINA": "0"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/github-billing-gate",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/crlf-normalize.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/crlf-normalize.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "clangd-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "plannotator@plannotator": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": { "source": "github", "repo": "DietrichGebert/ponytail" }
    },
    "plannotator": {
      "source": { "source": "github", "repo": "backnotprop/plannotator" }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": { "effortLevel": "high" }
  },
  "advisorModel": "opus",
  "autoUpdatesChannel": "latest",
  "skipWorkflowUsageWarning": true,
  "verbose": false,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoCompactWindow": 500000
}
