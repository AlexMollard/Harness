# >>> codebase-memory-mcp SessionStart >>>
[[hooks.SessionStart]]
matcher = "startup|resume|clear|compact"

[[hooks.SessionStart.hooks]]
type = "command"
command = 'echo "Code discovery: prefer codebase-memory-mcp (search_graph, trace_path, get_code_snippet, query_graph, search_code) over grep/file-read; run index_repository first if the project is not indexed."'
# <<< codebase-memory-mcp SessionStart <<<

# --- Local / self-hosted models via GPUStack -------------------------------
# Additive only: this registers the provider but does NOT change the default
# model above. Select it per-session with:
#     codex --model-provider gpustack --model <model-id>
# or make it the default by setting `model_provider = "gpustack"` at the top.
#
# Auth: set GPUSTACK_API_KEY in your environment (setx GPUSTACK_API_KEY "..."),
# then restart the shell. The key is deliberately NOT stored in this file.
#
# wire_api MUST be "responses" — Codex removed `wire_api = "chat"` support
# (see github.com/openai/codex/discussions/7782). GPUStack does route /v1/responses,
# but the backing model server has to implement it too; verify per model.
[model_providers.gpustack]
name = "GPUStack (BigAnt)"
base_url = "https://baai.ba.bigant-internal.com/v1"
env_key = "GPUSTACK_API_KEY"
wire_api = "responses"

[mcp_servers.aethercore]
command = "python"
args = ["D:/AetherCore/tools/mcp/aethercore_mcp.py"]

[mcp_servers.aethercore.env]
AETHER_CONTROL_PORT = "8787"
AETHER_REPO = "D:/AetherCore"
